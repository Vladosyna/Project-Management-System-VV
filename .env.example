# OCS API environment. Copy to .env (git-ignored) for local work; production values come from the secret store.
# Never commit real values (CLAUDE.md §3 rule 6).

# PostgreSQL in the EU deployment. The login role must be a member of ocs_app and ocs_auth.
OCS_DATABASE_URL=postgres://ocs:CHANGE_ME@localhost:5432/ocs
# At least 32 random characters, e.g. `openssl rand -hex 32`.
OCS_AUTH_SECRET=
# Public origin of the app; passkeys are bound to its host name.
OCS_PUBLIC_URL=http://localhost:3000
PORT=3000
