{
  "name": "@ocs/core",
  "private": true,
  "type": "module",
  "description": "All business logic, one folder per module; only <module>/index.ts is public",
  "exports": {
    "./*": "./*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.12",
    "@ocs/contracts": "workspace:*",
    "@ocs/db": "workspace:*",
    "better-auth": "1.7.12",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ocs/testing": "workspace:*"
  }
}
