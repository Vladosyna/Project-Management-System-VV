{
  "name": "@ocs/api",
  "private": true,
  "type": "module",
  "description": "HTTP API (Hono + zod-openapi). Thin: auth session → core → error mapping",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "bootstrap-admin": "tsx src/bootstrap-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@ocs/contracts": "workspace:*",
    "@ocs/core": "workspace:*",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@ocs/testing": "workspace:*",
    "otpauth": "9.5.2"
  }
}
